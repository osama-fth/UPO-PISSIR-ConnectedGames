<%- include('partials/header') %>

<!-- Match Header -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <div>
        <h1 style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.03em;">
            <%= match.giocoId === 'calciobalilla' ? '⚽' : '🎯' %> Partita in Corso
        </h1>
        <p class="text-muted" style="font-size: 0.85rem;">
            <%= match.giocoId === 'calciobalilla' ? 'Calciobalilla — Primo a 10 gol' : 'Freccette — 301' %>
            · <%= localeId %>
        </p>
    </div>
    <span class="badge badge-warning" style="font-size: 0.8rem; padding: 6px 14px;" id="match-status-badge">
        🔴 LIVE
    </span>
</div>

<!-- Scoreboard -->
<div class="card" style="margin-bottom: 2rem; padding: 2rem; text-align: center; border-top: 4px solid var(--accent-primary); background: linear-gradient(180deg, rgba(59, 130, 246, 0.05) 0%, transparent 100%);" id="scoreboard">
    <div style="display: flex; justify-content: center; align-items: center; gap: 2rem; flex-wrap: wrap;">
        <!-- Player 1 -->
        <div style="flex: 1; min-width: 140px;" id="player1-section">
            <div class="user-avatar" style="width: 56px; height: 56px; font-size: 1.5rem; margin: 0 auto 0.75rem;">
                <%= match.giocatore1.username.charAt(0).toUpperCase() %>
            </div>
            <div style="font-weight: 700; font-size: 1.1rem; margin-bottom: 0.25rem;"><%= match.giocatore1.username %></div>
            <div class="text-muted text-sm">Giocatore 1</div>
            <div style="font-size: 4rem; font-weight: 900; color: var(--accent-primary); line-height: 1.1; margin-top: 0.5rem; font-variant-numeric: tabular-nums;" id="score1">
                <%= match.punteggio1 %>
            </div>
        </div>

        <!-- VS Divider -->
        <div style="font-size: 1.5rem; font-weight: 800; color: var(--text-muted); letter-spacing: 0.1em;">
            VS
        </div>

        <!-- Player 2 -->
        <div style="flex: 1; min-width: 140px;" id="player2-section">
            <div class="user-avatar" style="width: 56px; height: 56px; font-size: 1.5rem; margin: 0 auto 0.75rem; background: linear-gradient(135deg, #ef4444, #f59e0b);">
                <%= match.giocatore2.username.charAt(0).toUpperCase() %>
            </div>
            <div style="font-weight: 700; font-size: 1.1rem; margin-bottom: 0.25rem;"><%= match.giocatore2.username %></div>
            <div class="text-muted text-sm">Giocatore 2</div>
            <div style="font-size: 4rem; font-weight: 900; color: var(--danger); line-height: 1.1; margin-top: 0.5rem; font-variant-numeric: tabular-nums;" id="score2">
                <%= match.punteggio2 %>
            </div>
        </div>
    </div>
</div>

<% if (match.giocoId === 'calciobalilla') { %>
<!-- ============================================== -->
<!-- CALCIOBALILLA CONTROLS -->
<!-- ============================================== -->
<div class="grid-3" style="gap: 1.5rem; margin-bottom: 2rem;">
    <button class="btn btn-primary btn-lg btn-block goal-btn" onclick="sendGoal('A')"
        style="padding: 2rem; font-size: 1.3rem; border-radius: var(--radius-lg); min-height: 120px; flex-direction: column; gap: 4px;"
        id="btn-goal-a">
        <span style="font-size: 2.5rem;">⚽</span>
        <span>GOL <%= match.giocatore1.username %></span>
    </button>

    <div style="display: flex; align-items: center; justify-content: center;">
        <div class="card" style="text-align: center; padding: 1.5rem; background: var(--bg-secondary); min-width: 100px;">
            <div class="text-muted text-sm" style="margin-bottom: 0.25rem;">PUNTEGGIO MAX</div>
            <div style="font-size: 2.5rem; font-weight: 900; color: var(--warning);">10</div>
        </div>
    </div>

    <button class="btn btn-lg btn-block goal-btn" onclick="sendGoal('B')"
        style="padding: 2rem; font-size: 1.3rem; border-radius: var(--radius-lg); min-height: 120px; flex-direction: column; gap: 4px; background: linear-gradient(135deg, #ef4444, #f59e0b); color: white; border: none; box-shadow: 0 2px 10px rgba(239, 68, 68, 0.3);"
        id="btn-goal-b">
        <span style="font-size: 2.5rem;">⚽</span>
        <span>GOL <%= match.giocatore2.username %></span>
    </button>
</div>

<% } else if (match.giocoId === 'freccette') { %>
<!-- ============================================== -->
<!-- FRECCETTE CONTROLS (301) -->
<!-- ============================================== -->

<!-- Turn Indicator -->
<div class="card" style="text-align: center; margin-bottom: 1.5rem; padding: 1rem; background: var(--bg-secondary);" id="turn-indicator">
    <span class="text-muted text-sm">TURNO DI</span>
    <div style="font-size: 1.2rem; font-weight: 700; margin-top: 0.25rem;" id="turn-player">
        <%= match.turnoCorrente === 1 ? match.giocatore1.username : match.giocatore2.username %>
    </div>
    <div class="text-muted text-sm" id="turn-shots">
        Tiri: <span id="shots-count"><%= match.tiriNelTurno %></span> / 3
    </div>
</div>

<!-- Multiplier Selector -->
<div class="card" style="margin-bottom: 1.5rem; text-align: center; padding: 1rem;">
    <div class="card-subtitle">MOLTIPLICATORE</div>
    <div style="display: flex; gap: 0.75rem; justify-content: center; margin-top: 0.5rem;">
        <button class="btn btn-secondary mult-btn active-mult" onclick="setMultiplier(1)" data-mult="1" style="min-width: 80px;">×1</button>
        <button class="btn btn-secondary mult-btn" onclick="setMultiplier(2)" data-mult="2" style="min-width: 80px;">×2 <span class="text-sm">(Doppio)</span></button>
        <button class="btn btn-secondary mult-btn" onclick="setMultiplier(3)" data-mult="3" style="min-width: 80px;">×3 <span class="text-sm">(Triplo)</span></button>
    </div>
</div>

<!-- Dartboard Sectors -->
<div class="card" style="margin-bottom: 2rem; padding: 1.5rem;">
    <div class="card-subtitle" style="text-align: center;">TABELLONE — CLICCA UN SETTORE</div>
    <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.5rem; margin-top: 1rem; max-width: 500px; margin-left: auto; margin-right: auto;" id="dartboard">
        <% for (let i = 1; i <= 20; i++) { %>
            <button class="btn btn-secondary dart-sector" onclick="sendDart(<%= i %>)"
                style="padding: 12px 8px; font-size: 1rem; font-weight: 700; border-radius: var(--radius-sm); transition: all 0.15s;">
                <%= i %>
            </button>
        <% } %>
    </div>
    <!-- Bull's Eye -->
    <div style="display: flex; gap: 0.75rem; justify-content: center; margin-top: 1rem;">
        <button class="btn btn-warning" onclick="sendDart('BULL')" style="min-width: 120px; font-weight: 700;">
            🎯 Bull (25)
        </button>
        <button class="btn btn-danger" onclick="sendDart('DBULL')" style="min-width: 120px; font-weight: 700;">
            🎯 D-Bull (50)
        </button>
    </div>
</div>

<% } %>

<!-- Event Log -->
<details class="mt-2" style="color: var(--text-muted); font-size: 0.75rem;">
    <summary style="cursor: pointer; user-select: none;">📋 Log Eventi</summary>
    <div class="card mt-1" style="font-family: monospace; font-size: 0.7rem; max-height: 200px; overflow-y: auto;" id="event-log">
        <div class="text-muted">In attesa di eventi...</div>
    </div>
</details>

<!-- Match Ended Overlay (nascosto) -->
<div id="match-ended-overlay" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); z-index: 1000; display: none; align-items: center; justify-content: center;">
    <div class="card" style="text-align: center; padding: 3rem; max-width: 500px; animation: fadeInUp 0.5s ease;">
        <div style="font-size: 4rem; margin-bottom: 1rem;">🏆</div>
        <h2 style="font-size: 1.75rem; font-weight: 800; margin-bottom: 0.5rem;">Partita Terminata!</h2>
        <p style="font-size: 1.2rem; color: var(--accent-primary); font-weight: 700; margin-bottom: 0.5rem;" id="winner-text"></p>
        <p class="text-muted" style="margin-bottom: 1.5rem;" id="final-score-text"></p>
        <div style="display: flex; gap: 1rem; justify-content: center;">
            <a href="/game/<%= match.id %>/result" class="btn btn-primary btn-lg">📊 Vedi Risultato</a>
            <a href="/" class="btn btn-secondary btn-lg">← Dashboard</a>
        </div>
    </div>
</div>

<style>
    .goal-btn:active { transform: scale(0.95); }
    .dart-sector:hover { background: var(--accent-primary) !important; color: white !important; transform: scale(1.05); }
    .dart-sector:active { transform: scale(0.95); }
    .mult-btn.active-mult {
        background: var(--accent-gradient) !important;
        color: white !important;
        border-color: var(--accent-primary) !important;
        box-shadow: 0 2px 10px rgba(59, 130, 246, 0.3) !important;
    }
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .flash-score { animation: flashPulse 0.3s ease; }
    @keyframes flashPulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.2); color: var(--warning); }
        100% { transform: scale(1); }
    }
</style>

<script>
    const MATCH_ID = '<%= match.id %>';
    const GIOCO = '<%= match.giocoId %>';
    let currentMultiplier = 1;
    let isProcessing = false;

    // Calciobalilla: invia evento GOL
    function sendGoal(team) {
        if (isProcessing) return;
        sendEvent({ tipo: 'GOAL', team: team });
    }

    // Freccette: invia evento TIRO
    function sendDart(settore) {
        if (isProcessing) return;
        sendEvent({ tipo: 'TIRO', settore: settore, moltiplicatore: currentMultiplier });
    }

    // Imposta il moltiplicatore delle freccette
    function setMultiplier(mult) {
        currentMultiplier = mult;
        document.querySelectorAll('.mult-btn').forEach(btn => {
            btn.classList.toggle('active-mult', parseInt(btn.dataset.mult) === mult);
        });
    }

    // Invia un evento di gioco al server
    async function sendEvent(evento) {
        isProcessing = true;
        try {
            const res = await fetch('/game/' + MATCH_ID + '/event', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(evento)
            });

            const data = await res.json();

            if (!res.ok) {
                logEvent('❌ Errore: ' + (data.error || 'Sconosciuto'));
                return;
            }

            updateScoreboard(data);
            logEvent(formatEvent(evento, data));

            if (data.stato === 'TERMINATA') {
                showMatchEnded(data);
            }
        } catch (err) {
            logEvent('❌ Errore di rete: ' + err.message);
        } finally {
            isProcessing = false;
        }
    }

    // Aggiorna il tabellone dei punteggi
    function updateScoreboard(data) {
        const s1 = document.getElementById('score1');
        const s2 = document.getElementById('score2');
        s1.textContent = data.punteggio1;
        s2.textContent = data.punteggio2;
        s1.classList.remove('flash-score');
        s2.classList.remove('flash-score');
        void s1.offsetWidth; // force reflow
        s1.classList.add('flash-score');
        s2.classList.add('flash-score');

        // Aggiorna indicatore turno per freccette
        if (GIOCO === 'freccette' && data.turnoCorrente) {
            const turnPlayer = document.getElementById('turn-player');
            const shotsCount = document.getElementById('shots-count');
            if (turnPlayer) {
                turnPlayer.textContent = data.turnoCorrente === 1 ? data.giocatore1.username : data.giocatore2.username;
            }
            if (shotsCount) {
                shotsCount.textContent = data.tiriNelTurno;
            }
        }
    }

    // Formatta un evento per il log
    function formatEvent(evento, data) {
        const ts = new Date().toLocaleTimeString('it-IT');
        if (evento.tipo === 'GOAL') {
            return ts + ' — ⚽ GOL Team ' + evento.team + ' → ' + data.punteggio1 + '-' + data.punteggio2;
        } else if (evento.tipo === 'TIRO') {
            const val = evento.settore === 'BULL' ? '25' : evento.settore === 'DBULL' ? '50' : (evento.settore + '×' + evento.moltiplicatore);
            return ts + ' — 🎯 Tiro: ' + val + ' → G1=' + data.punteggio1 + ' G2=' + data.punteggio2;
        }
        return ts + ' — Evento: ' + JSON.stringify(evento);
    }

    // Aggiungi un messaggio al log eventi
    function logEvent(msg) {
        const log = document.getElementById('event-log');
        const line = document.createElement('div');
        line.textContent = msg;
        line.style.padding = '4px 0';
        line.style.borderBottom = '1px solid var(--border-color)';
        log.prepend(line);
    }

    // Mostra l'overlay di fine partita
    function showMatchEnded(data) {
        document.getElementById('winner-text').textContent = '🏆 Vincitore: ' + data.vincitore;
        document.getElementById('final-score-text').textContent = data.punteggio1 + ' — ' + data.punteggio2;
        document.getElementById('match-status-badge').innerHTML = '✅ TERMINATA';
        document.getElementById('match-status-badge').className = 'badge badge-success';

        const overlay = document.getElementById('match-ended-overlay');
        overlay.style.display = 'flex';

        // Disabilita i pulsanti
        document.querySelectorAll('.goal-btn, .dart-sector, .mult-btn').forEach(btn => {
            btn.disabled = true;
            btn.style.opacity = '0.5';
            btn.style.pointerEvents = 'none';
        });
    }
</script>

<%- include('partials/footer') %>
