# ==========================================
# Configurazione Globale Connected Games
# ==========================================

# Database Principale (PostgreSQL)
POSTGRES_USER=platform_admin
POSTGRES_PASSWORD=super_secret_db_password

# Autenticazione Keycloak (Admin Console)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password_123

# OIDC Client (Edge → Keycloak)
KEYCLOAK_CLIENT_ID=edge-client

# Sessione Edge
SESSION_SECRET=your_super_secret_session_key

# Sessione Statistiche
STATS_SESSION_SECRET=your_super_secret_stats_session_key

# Credenziali MQTT — Locale 1 (Bar Belvedere)
MQTT1_PUBLISH_USER=simulator
MQTT1_PUBLISH_PASSWORD=mqtt1_sim_secret
MQTT1_SUBSCRIBE_USER=edge-client
MQTT1_SUBSCRIBE_PASSWORD=mqtt1_edge_secret

# Credenziali MQTT — Locale 2 (Sala Giochi Roma)
MQTT2_PUBLISH_USER=simulator
MQTT2_PUBLISH_PASSWORD=mqtt2_sim_secret
MQTT2_SUBSCRIBE_USER=edge-client
MQTT2_SUBSCRIBE_PASSWORD=mqtt2_edge_secret

# Porte Host
KEYCLOAK_HOST_PORT=9080
EDGE1_HOST_PORT=3001
EDGE2_HOST_PORT=3002
STATS_HOST_PORT=3000
