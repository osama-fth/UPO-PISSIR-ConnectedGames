<%- include('partials/header') %>

<div style="min-height: 60vh; display: flex; align-items: center; justify-content: center;">
    <div class="card text-center" style="max-width: 500px; padding: 3rem 2rem;">
        <div style="font-size: 3rem; margin-bottom: 1rem;">⚠️</div>
        <h1 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 0.75rem; letter-spacing: -0.02em;">
            <%= typeof title !== 'undefined' ? title : 'Errore' %>
        </h1>
        <p class="text-muted" style="margin-bottom: 1.5rem; font-size: 0.9rem;">
            <%= typeof message !== 'undefined' ? message : 'Si è verificato un errore imprevisto.' %>
        </p>
        <a href="/" class="btn btn-primary">← Torna alla Dashboard</a>
    </div>
</div>

<%- include('partials/footer') %>
