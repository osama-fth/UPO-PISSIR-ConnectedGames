<%- include('partials/header') %>

<!-- Page Header -->
<div style="margin-bottom: 2rem;">
    <h1 style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.03em;">
        Dashboard Globale
    </h1>
    <p class="text-muted" style="font-size: 0.9rem;">
        Pannello di controllo Admin Piattaforma
    </p>
</div>

<!-- Status Cards -->
<div class="grid-3 mb-3">
    <!-- User Info -->
    <div class="card">
        <div class="card-subtitle">UTENTE</div>
        <div class="card-title" style="font-size: 1.25rem;">
            🔐 <%= user.username %>
        </div>
        <div class="mt-1">
            <span class="badge badge-danger">SUPER ADMIN</span>
        </div>
        <% if (user.email) { %>
            <p class="text-muted text-sm mt-1"><%= user.email %></p>
        <% } %>
    </div>
</div>

<div class="card mb-3" style="border-top: 4px solid var(--accent-primary);">
    <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 1rem;">🌍 Statistiche Piattaforma</h2>

    <div class="grid-3" style="gap: 1rem; margin-bottom: 1.25rem;">
        <div class="card" style="background: var(--bg-secondary); text-align: center;">
            <div class="card-subtitle">PARTITE TOTALI (Tutti i locali)</div>
            <div style="font-size: 2.5rem; font-weight: 800; color: var(--accent-primary);">
                <%= stats ? stats.totalePartite : 0 %>
            </div>
        </div>
        <div class="card" style="background: var(--bg-secondary); text-align: center;">
            <div class="card-subtitle">UTENTI REGISTRATI</div>
            <div style="font-size: 2.5rem; font-weight: 800; color: var(--success);">
                <%= stats ? stats.totaleUtenti : 0 %>
            </div>
        </div>
        <div class="card" style="background: var(--bg-secondary); text-align: center;">
            <div class="card-subtitle">TORNEI ATTIVI</div>
            <div style="font-size: 2.5rem; font-weight: 800; color: var(--warning);">
                <%= stats ? stats.totaleTornei : 0 %>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
