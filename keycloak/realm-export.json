{
  "id": "pissir-realm",
  "realm": "pissir-realm",
  "displayName": "Connected Games Platform",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "defaultRoles": [
    "giocatore"
  ],
  "roles": {
    "realm": [
      {
        "name": "giocatore",
        "description": "Ruolo base per i giocatori della piattaforma"
      },
      {
        "name": "admin_locale",
        "description": "Amministratore di un locale fisico"
      },
      {
        "name": "admin_piattaforma",
        "description": "Amministratore globale della piattaforma"
      },
      {
        "name": "default-roles-pissir-realm",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "giocatore"
          ]
        },
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "edge-client",
      "name": "Edge Gateway Application",
      "description": "Client OIDC per gli Edge Node locali",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+",
        "_comment": "SOLO DEV \u2014 restringere redirectUris e webOrigins in produzione"
      },
      "protocolMappers": [
        {
          "name": "locale_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "locale_id",
            "claim.name": "locale_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email_verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.value": "true",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "platform-client",
      "name": "Platform Dashboard",
      "description": "Client OIDC per la Dashboard Super Admin",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocolMappers": [
        {
          "name": "email_verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.value": "true",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "edge-sync-client",
      "name": "Edge Sync Service Client",
      "description": "Client confidentiale per il demone di sincronizzazione Edge (Fix M5)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "edge-sync-secret-12345",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
