<%- include('partials/header') %>

<!-- Result Header -->
<div style="text-align: center; margin-bottom: 2rem;">
    <div style="font-size: 4rem; margin-bottom: 0.75rem; color: var(--warning);">
        <i class="bi bi-trophy"></i>
    </div>
    <h1 style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.03em;">
        Partita Completata
    </h1>
    <p class="text-muted" style="font-size: 0.9rem;">
        <% if (match.giocoId === 'calciobalilla') { %>
            <i class="bi bi-dribbble"></i> Calciobalilla
        <% } else if (match.giocoId === 'biliardo') { %>
            <i class="bi bi-8-circle text-primary"></i> Biliardo 8-Ball
        <% } else { %>
            <i class="bi bi-bullseye"></i> Freccette 301
        <% } %>
        · <%= localeId %>
    </p>
</div>

<!-- Result Card -->
<div class="card" style="max-width: 600px; margin: 0 auto 2rem; padding: 2.5rem; text-align: center; border-top: 4px solid var(--success); background: linear-gradient(180deg, rgba(16, 185, 129, 0.05) 0%, transparent 100%);">

    <!-- Scoreboard -->
    <div style="display: flex; justify-content: center; align-items: center; gap: 2rem; margin-bottom: 2rem;">
        <!-- Player 1 -->
        <div>
            <div class="user-avatar" style="width: 64px; height: 64px; font-size: 1.5rem; margin: 0 auto 0.75rem;
                <%= match.vincitore === match.giocatore1.username ? 'box-shadow: 0 0 20px rgba(16, 185, 129, 0.5); border: 2px solid var(--success);' : '' %>">
                <%= match.giocatore1.username.charAt(0).toUpperCase() %>
            </div>
            <div style="font-weight: 700; font-size: 1.1rem;"><%= match.giocatore1.username %></div>
            <% if (match.vincitore === match.giocatore1.username) { %>
                <span class="badge badge-success" style="margin-top: 0.25rem;"><i class="bi bi-star-fill"></i> VINCITORE</span>
            <% } %>
            <div style="font-size: 3rem; font-weight: 900; color: <%= match.vincitore === match.giocatore1.username ? 'var(--success)' : 'var(--text-muted)' %>; margin-top: 0.5rem;">
                <%= match.punteggio1 %>
            </div>
        </div>

        <div style="font-size: 1.5rem; font-weight: 800; color: var(--text-muted);">—</div>

        <!-- Player 2 -->
        <div>
            <div class="user-avatar" style="width: 64px; height: 64px; font-size: 1.5rem; margin: 0 auto 0.75rem; background: linear-gradient(135deg, #ef4444, #f59e0b);
                <%= match.vincitore === match.giocatore2.username ? 'box-shadow: 0 0 20px rgba(16, 185, 129, 0.5); border: 2px solid var(--success);' : '' %>">
                <%= match.giocatore2.username.charAt(0).toUpperCase() %>
            </div>
            <div style="font-weight: 700; font-size: 1.1rem;"><%= match.giocatore2.username %></div>
            <% if (match.vincitore === match.giocatore2.username) { %>
                <span class="badge badge-success" style="margin-top: 0.25rem;"><i class="bi bi-star-fill"></i> VINCITORE</span>
            <% } %>
            <div style="font-size: 3rem; font-weight: 900; color: <%= match.vincitore === match.giocatore2.username ? 'var(--success)' : 'var(--text-muted)' %>; margin-top: 0.5rem;">
                <%= match.punteggio2 %>
            </div>
        </div>
    </div>

    <!-- Match Details -->
    <div style="border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; text-align: left; max-width: 550px; margin: 0 auto;">
            <div>
                <div class="text-muted text-sm" style="text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; margin-bottom: 0.25rem;">Gioco</div>
                <div style="font-weight: 600;">
                    <% if (match.giocoId === 'calciobalilla') { %>
                        <i class="bi bi-dribbble"></i> Calciobalilla
                    <% } else if (match.giocoId === 'biliardo') { %>
                        <i class="bi bi-8-circle text-primary"></i> Biliardo 8-Ball
                    <% } else { %>
                        <i class="bi bi-bullseye"></i> Freccette 301
                    <% } %>
                </div>
            </div>
            <div>
                <div class="text-muted text-sm" style="text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; margin-bottom: 0.25rem;">Locale</div>
                <div style="font-weight: 600;"><i class="bi bi-geo-alt"></i> <%= localeId %></div>
            </div>
            <div>
                <div class="text-muted text-sm" style="text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; margin-bottom: 0.25rem;">Durata</div>
                <div style="font-weight: 600;">
                    <i class="bi bi-stopwatch"></i>
                    <% if (match.dataInizio && match.dataFine) {
                        var durMs = new Date(match.dataFine) - new Date(match.dataInizio);
                        var durSec = Math.floor(durMs / 1000);
                        var durMin = Math.floor(durSec / 60);
                        var durSecRem = durSec % 60;
                    %>
                        <%= durMin %>m <%= durSecRem %>s
                    <% } else { %>
                        —
                    <% } %>
                </div>
            </div>
            <div>
                <div class="text-muted text-sm" style="text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; margin-bottom: 0.25rem;">Inizio</div>
                <div style="font-weight: 600;"><%= new Date(match.dataInizio).toLocaleString('it-IT', { timeZone: 'Europe/Rome' }) %></div>
            </div>
            <div>
                <div class="text-muted text-sm" style="text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; margin-bottom: 0.25rem;">Fine</div>
                <div style="font-weight: 600;"><%= match.dataFine ? new Date(match.dataFine).toLocaleString('it-IT', { timeZone: 'Europe/Rome' }) : '—' %></div>
            </div>
            <% if (match.torneoId) { %>
            <div>
                <div class="text-muted text-sm" style="text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; margin-bottom: 0.25rem;">Torneo</div>
                <div style="font-weight: 600;"><i class="bi bi-trophy text-warning"></i> Partita di torneo</div>
            </div>
            <% } %>
        </div>
    </div>

    <!-- Save Status -->
    <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
        <% if (match.giocatore1.id && match.giocatore2.id) { %>
            <div class="badge badge-success" style="font-size: 0.75rem; padding: 6px 14px;">
                <i class="bi bi-save"></i> Partita salvata nel buffer locale — in attesa di sincronizzazione
            </div>
        <% } else { %>
            <div class="badge badge-warning" style="font-size: 0.75rem; padding: 6px 14px;">
                <i class="bi bi-exclamation-triangle"></i> Partita ospite — non salvata
            </div>
        <% } %>
    </div>
</div>

<!-- Actions -->
<div style="text-align: center;">
    <a href="/" class="btn btn-primary btn-lg" style="min-width: 220px;">
        <i class="bi bi-house"></i> Torna alla Home
    </a>
</div>

<%- include('partials/footer') %>
