<%- include('partials/header') %>

<div style="min-height: 80vh; display: flex; align-items: center; justify-content: center;">
    <div style="width: 100%; max-width: 440px;">
        <!-- Logo / Header -->
        <div class="text-center mb-3">
            <div style="width: 72px; height: 72px; background: var(--accent-gradient); border-radius: 20px; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; font-size: 2rem; font-weight: 800; color: white; box-shadow: 0 0 40px rgba(59, 130, 246, 0.3);">
                CG
            </div>
            <h1 style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 0.25rem;">
                Connected Games
            </h1>
            <p class="text-muted" style="font-size: 0.9rem;">
                <%= localeId %> — Accedi per iniziare a giocare
            </p>
        </div>

        <!-- Error Message -->
        <% if (error) { %>
            <div class="alert alert-danger">
                ⚠️
                <% if (error === 'keycloak_unreachable') { %>
                    Server di autenticazione non raggiungibile.
                <% } else if (error === 'state_mismatch') { %>
                    Errore di sicurezza nella risposta. Riprova.
                <% } else if (error === 'token_exchange_failed') { %>
                    Errore nello scambio del token. Riprova.
                <% } else if (error === 'missing_code') { %>
                    Risposta incompleta dal server di autenticazione.
                <% } else { %>
                    Si è verificato un errore durante l'accesso.
                <% } %>
            </div>
        <% } %>

        <!-- Login Card -->
        <div class="card" style="padding: 2rem;">
            <% if (keycloakOnline) { %>
                <!-- Keycloak è raggiungibile: mostra login e registrazione -->
                <a href="/auth/start" class="btn btn-primary btn-lg btn-block" id="btn-login"
                   style="margin-bottom: 0.5rem;">
                    🔐 Accedi con il tuo Account
                </a>

                <div style="text-align: center; color: var(--text-muted); font-size: 0.8rem; margin: 1rem 0;">
                    oppure
                </div>

                <a href="/auth/register" class="btn btn-secondary btn-lg btn-block" id="btn-register">
                    ✨ Registrati
                </a>

                <div class="mt-3 text-center" style="padding-top: 1.25rem; border-top: 1px solid var(--border-color);">
                    <span class="badge badge-success"><span class="dot dot-success"></span> Keycloak Online</span>
                </div>
            <% } else { %>
                <!-- Keycloak NON raggiungibile: mostra Guest Mode -->
                <div class="alert alert-warning" style="margin-bottom: 1.5rem;">
                    ⚠️ Il server di autenticazione non è raggiungibile. Puoi accedere in modalità Ospite.
                </div>

                <form action="/auth/guest" method="POST">
                    <button type="submit" class="btn btn-warning btn-lg btn-block" id="btn-guest">
                        👤 Accedi come Ospite
                    </button>
                </form>

                <p class="text-muted text-sm text-center mt-2">
                    In modalità Ospite puoi giocare liberamente, ma i risultati delle partite non verranno salvati.
                </p>

                <div class="mt-3 text-center" style="padding-top: 1.25rem; border-top: 1px solid var(--border-color);">
                    <span class="badge badge-danger"><span class="dot dot-danger"></span> Keycloak Offline</span>
                </div>
            <% } %>
        </div>

        <!-- Footer info -->
        <div class="text-center text-muted text-sm mt-2">
            Connected Games Platform — PISSIR A.A. 2025/2026
        </div>
    </div>
</div>

<%- include('partials/footer') %>
