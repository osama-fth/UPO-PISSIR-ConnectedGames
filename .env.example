# ==========================================
# Configurazione Globale Connected Games
# ==========================================

# Database Principale (PostgreSQL Admin & Segregated Users, Fix M6)
POSTGRES_USER=platform_admin
POSTGRES_PASSWORD=super_secret_db_password
PLATFORM_DB_USER=platform_user
PLATFORM_DB_PASSWORD=platform_secret_pass
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASSWORD=keycloak_secret_pass

# Autenticazione Keycloak (Admin Console)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password_123

# OIDC Client & Resource Servers
KEYCLOAK_CLIENT_ID=edge-client
JWT_ISSUER_URI=http://localhost:9080/realms/Connected-Games
JWT_JWK_SET_URI=http://keycloak:8080/realms/Connected-Games/protocol/openid-connect/certs

# Sessione Edge
SESSION_SECRET=your_super_secret_session_key

# Client Credentials Sincronizzazione Edge → Cloud
SYNC_CLIENT_ID=edge-sync-client
SYNC_CLIENT_SECRET=edge-sync-secret-12345

# Credenziali MQTT — Locale 1 (Bar Belvedere)
MQTT1_PUBLISH_USER=simulator1
MQTT1_PUBLISH_PASSWORD=mqtt1_sim_secret
MQTT1_SUBSCRIBE_USER=edge-client1
MQTT1_SUBSCRIBE_PASSWORD=mqtt1_edge_secret

# Credenziali MQTT — Locale 2 (Sala Giochi Roma)
MQTT2_PUBLISH_USER=simulator2
MQTT2_PUBLISH_PASSWORD=mqtt2_sim_secret
MQTT2_SUBSCRIBE_USER=edge-client2
MQTT2_SUBSCRIBE_PASSWORD=mqtt2_edge_secret

# Porte Host
EDGE1_HOST_PORT=3001
EDGE2_HOST_PORT=3002
