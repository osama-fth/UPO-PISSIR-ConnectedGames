<%- include('partials/header') %>

<!-- Page Header -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <div>
        <h1 style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.03em;">
            <i class="bi bi-speedometer2"></i> Dashboard
        </h1>
    </div>
</div>

<!-- Status Cards -->
<div class="grid-3 mb-3">
    <!-- User Info -->
    <div class="card">
        <div class="card-subtitle">UTENTE</div>
        <div class="card-title" style="font-size: 1.25rem;">
            <% if (user.isGuest) { %>
                <i class="bi bi-person"></i>
            <% } else { %>
                <i class="bi bi-shield-check"></i>
            <% } %>
            <%= user.username %>
        </div>
        <% if (user.email) { %>
            <p class="text-muted text-sm mt-1"><%= user.email %></p>
        <% } %>
    </div>

    <% if (isAdmin) { %>
    <!-- MQTT Status -->
    <div class="card">
        <div class="card-subtitle">BROKER MQTT</div>
        <div class="card-title" style="font-size: 1.25rem;">
            <% if (mqttStatus.status === 'connected') { %>
                <span class="dot dot-success"></span> Connesso
            <% } else if (mqttStatus.status === 'reconnecting') { %>
                <i class="bi bi-arrow-repeat" style="color: var(--warning);"></i> Riconnessione...
            <% } else { %>
                <span class="dot dot-danger"></span> Disconnesso
            <% } %>
        </div>
    </div>

    <!-- Cloud Centrale Status -->
    <div class="card">
        <div class="card-subtitle">CLOUD CENTRALE</div>
        <div class="card-title" style="font-size: 1.25rem;">
            <% if (cloudStatus.status === 'connected') { %>
                <span class="dot dot-success"></span> Raggiungibile
            <% } else if (cloudStatus.status === 'degraded') { %>
                <i class="bi bi-exclamation-triangle" style="color: var(--warning);"></i> Degradato
            <% } else if (cloudStatus.status === 'unknown') { %>
                <i class="bi bi-question-circle" style="color: var(--text-muted);"></i> Verifica...
            <% } else { %>
                <span class="dot dot-danger"></span> Non raggiungibile
            <% } %>
        </div>
        <% if (cloudStatus.lastCheck) { %>
            <p class="text-muted text-sm mt-1">
                Ultimo check: <%= new Date(cloudStatus.lastCheck).toLocaleTimeString('it-IT') %>
            </p>
        <% } %>
    </div>
    <% } %>
</div>

<% if (isAdmin) { %>
    <div class="grid-3 mb-3" style="gap: 1rem;">
    <!-- Locale Info -->
    <div class="card" style="text-align: center;">
        <div class="card-subtitle">LOCALE</div>
        <div style="font-size: 2rem; font-weight: 800; color: var(--accent-primary);"><%= localeId %></div>
    </div>
    <div class="card" style="text-align: center;">
        <div class="card-subtitle">PARTITE GIOCATE</div>
        <div style="font-size: 2rem; font-weight: 800; color: var(--accent-secondary);"><%= stats.totalePartite %></div>
    </div>
    <div class="card" style="text-align: center;">
        <div class="card-subtitle">IN CODA SYNC</div>
        <div style="font-size: 2rem; font-weight: 800; color: <%= stats.inAttesaDiSync > 0 ? 'var(--warning)' : 'var(--success)' %>;"><%= stats.inAttesaDiSync %></div>
    </div>
    </div>

    <!-- ============================================== -->
    <!-- PANNELLO AMMINISTRATORE & SYNC PARTITE -->
    <!-- ============================================== -->
    <div class="card mb-3" style="border-top: 4px solid var(--warning); background: linear-gradient(180deg, rgba(245, 158, 11, 0.05) 0%, transparent 100%);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h2 style="font-size: 1.4rem; font-weight: 700; color: var(--warning); margin: 0;">
                <% if (user.roles && user.roles.includes('admin_piattaforma')) { %>
                    <i class="bi bi-globe"></i> Console Admin Piattaforma
                <% } else { %>
                    <i class="bi bi-gear"></i> Console Admin Locale
                <% } %>
            </h2>
        </div>

        <!-- Sync Action -->
        <div style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: center;">
            <button class="btn btn-warning" onclick="triggerSync()" id="btn-sync">
                <i class="bi bi-arrow-repeat"></i> Sincronizza Ora
            </button>
            <span class="text-muted text-sm" style="align-self: center;" id="sync-status"></span>
        </div>
    </div>

    <!-- ============================================== -->
    <!-- FORM CREAZIONE TORNEO (solo admin) -->
    <!-- ============================================== -->
    <div class="card mb-3" style="border-top: 4px solid var(--accent-secondary);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h2 style="font-size: 1.3rem; font-weight: 700;"><i class="bi bi-plus-circle text-success"></i> Crea Nuovo Torneo</h2>
        </div>
        <form id="form-crea-torneo" onsubmit="creaTorneo(event)">
            <div class="grid-2" style="gap: 1rem; margin-bottom: 1rem;">
                <div>
                    <label style="display: block; font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 0.35rem; text-transform: uppercase;">Nome Torneo</label>
                    <input type="text" id="t-nome" required style="width: 100%; padding: 8px 12px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: var(--bg-primary); color: var(--text-primary); font-family: 'Inter', sans-serif; font-size: 0.9rem; outline: none;" placeholder="es. Torneo Estivo 2026">
                </div>
                <div>
                    <label style="display: block; font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 0.35rem; text-transform: uppercase;">Gioco</label>
                    <select id="t-gioco" required style="width: 100%; padding: 8px 12px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: var(--bg-primary); color: var(--text-primary); font-family: 'Inter', sans-serif; font-size: 0.9rem; outline: none;">
                        <% installazioni.forEach(function(inst) { %>
                            <option value="<%= inst.giocoId %>"><%= inst.nome %></option>
                        <% }); %>
                    </select>
                </div>
            </div>
            <div class="grid-3" style="gap: 1rem; margin-bottom: 1rem;">
                <div>
                    <label style="display: block; font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 0.35rem; text-transform: uppercase;">Data e Ora Inizio</label>
                    <input type="datetime-local" id="t-inizio" required style="width: 100%; padding: 8px 12px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: var(--bg-primary); color: var(--text-primary); color-scheme: dark; font-family: 'Inter', sans-serif; font-size: 0.9rem; outline: none; cursor: pointer;">
                </div>
                <div>
                    <label style="display: block; font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 0.35rem; text-transform: uppercase;">Data e Ora Fine</label>
                    <input type="datetime-local" id="t-fine" required style="width: 100%; padding: 8px 12px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: var(--bg-primary); color: var(--text-primary); color-scheme: dark; font-family: 'Inter', sans-serif; font-size: 0.9rem; outline: none; cursor: pointer;">
                </div>
                <div style="display: flex; align-items: flex-end;">
                    <button type="submit" class="btn btn-success" style="width: 100%;">
                        <i class="bi bi-plus-circle"></i> Crea Torneo
                    </button>
                </div>
            </div>
            <div id="crea-torneo-alert" class="alert d-none" style="font-size: 0.9rem;"></div>
        </form>
    </div>
<% } %>

<% if (!isAdmin && !user.isGuest && playerStats) { %>
    <!-- ============================================== -->
    <!-- STATISTICHE GIOCATORE INTERATTIVE -->
    <!-- ============================================== -->
    <div class="card mb-3" style="border-top: 4px solid var(--accent-secondary); background: linear-gradient(180deg, rgba(6, 182, 212, 0.05) 0%, transparent 100%);">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
            <h2 style="font-size: 1.4rem; font-weight: 700; margin: 0;"><i class="bi bi-bar-chart-line text-cyan"></i> Le tue Statistiche Personali</h2>
        </div>

        <!-- Control Bar Filtri Giocatore -->
        <div style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 0.75rem 1rem; margin-bottom: 1.25rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                <span class="text-muted text-sm" style="font-weight: 600; text-transform: uppercase;"><i class="bi bi-calendar3"></i> Periodo:</span>
                <div style="display: flex; gap: 6px;">
                    <button type="button" class="btn btn-sm btn-primary user-period-btn" onclick="filterUserStats(null, this)" style="padding: 4px 12px;">Tutti i Tempi</button>
                    <button type="button" class="btn btn-sm btn-secondary user-period-btn" onclick="filterUserStats(30, this)" style="padding: 4px 12px;">30 Giorni</button>
                    <button type="button" class="btn btn-sm btn-secondary user-period-btn" onclick="filterUserStats(7, this)" style="padding: 4px 12px;">7 Giorni</button>
                </div>
            </div>

            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <span class="text-muted text-sm" style="font-weight: 600; text-transform: uppercase;"><i class="bi bi-controller"></i> Gioco:</span>
                <select id="user-gioco-select" onchange="filterUserStats(currentUserPeriod, null)" style="padding: 4px 10px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: var(--bg-primary); color: var(--text-primary); font-size: 0.85rem; outline: none;">
                    <option value="">Tutti i Giochi</option>
                    <% installazioni.forEach(function(inst) { %>
                        <option value="<%= inst.giocoId %>"><%= inst.nome %></option>
                    <% }); %>
                </select>
            </div>
        </div>

        <!-- 3 KPI Cards Dinamiche -->
        <div class="grid-3" style="gap: 1rem; margin-bottom: 1.25rem;">
            <div class="card" style="background: var(--bg-secondary); text-align: center;">
                <div class="card-subtitle">PARTITE GIOCATE</div>
                <div id="u-stat-partite" style="font-size: 2.5rem; font-weight: 800; color: var(--accent-primary);"><%= playerStats.totalePartite %></div>
            </div>
            <div class="card" style="background: var(--bg-secondary); text-align: center;">
                <div class="card-subtitle">VITTORIE / SCONFITTE</div>
                <div style="font-size: 2rem; font-weight: 800;">
                    <span id="u-stat-vittorie" style="color: var(--success);"><%= playerStats.vittorie %></span>
                    <span style="color: var(--text-muted);"> / </span>
                    <span id="u-stat-sconfitte" style="color: var(--danger);"><%= playerStats.sconfitte %></span>
                </div>
            </div>
            <div class="card" style="background: var(--bg-secondary); text-align: center;">
                <div class="card-subtitle">% VITTORIE</div>
                <div id="u-stat-winrate" style="font-size: 2.5rem; font-weight: 800; color: <%= playerStats.percentualeVittorie >= 50 ? 'var(--success)' : 'var(--danger)' %>;">
                    <%= playerStats.percentualeVittorie %>%
                </div>
            </div>
        </div>

        <!-- Grafici Interattivi Chart.js -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
            <div class="card" style="background: var(--bg-secondary);">
                <div class="card-subtitle">
                    <i class="bi bi-graph-up-arrow text-success"></i> Trend Punteggi &amp; Esiti
                </div>
                <div style="position: relative; height: 200px; width: 100%;">
                    <canvas id="userTrendChart"></canvas>
                </div>
            </div>

            <div class="card" style="background: var(--bg-secondary);">
                <div class="card-subtitle">
                    <i class="bi bi-pie-chart-fill text-warning"></i> Vittorie per Gioco
                </div>
                <div style="position: relative; height: 200px; width: 100%; display: flex; justify-content: center; align-items: center;">
                    <canvas id="userGamesChart"></canvas>
                </div>
            </div>
        </div>
                    <canvas id="userGamesChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Ultime Partite Filtrabili -->
        <h3 style="font-size: 1rem; color: var(--text-secondary); margin-bottom: 0.75rem; text-transform: uppercase; letter-spacing: 1px;"><i class="bi bi-clock-history"></i> Storico Partite</h3>
        <div id="user-matches-list">
            <% if (playerStats.ultimePartite && playerStats.ultimePartite.length > 0) { %>
                <% playerStats.ultimePartite.forEach(function(p) {
                    var isP1 = p.giocatore_1_id === user.id;
                    var won = isP1 ? (p.punteggio_1 > p.punteggio_2) : (p.punteggio_2 > p.punteggio_1);
                %>
                    <div class="user-match-item" data-gioco="<%= p.gioco_id %>" data-date="<%= p.data_fine %>" style="display: flex; align-items: center; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--border-color);">
                        <div>
                            <span class="badge <%= won ? 'badge-success' : 'badge-danger' %>"><%= won ? 'VITTORIA' : 'SCONFITTA' %></span>
                        </div>
                        <div style="font-weight: 600; text-transform: capitalize;">
                            <% if (p.gioco_id === 'calciobalilla') { %>
                                <i class="bi bi-dribbble"></i>
                            <% } else if (p.gioco_id === 'biliardo') { %>
                                <i class="bi bi-8-circle"></i>
                            <% } else { %>
                                <i class="bi bi-bullseye"></i>
                            <% } %>
                            <%= p.gioco_id %>
                        </div>
                        <div style="font-weight: 700;">
                            <%= p.punteggio_1 %> — <%= p.punteggio_2 %>
                        </div>
                        <div class="text-muted text-sm">
                            <%= new Date(p.data_fine).toLocaleString('it-IT', { timeZone: 'Europe/Rome' }) %>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <p class="text-muted">Nessuna partita registrata.</p>
            <% } %>
        </div>
    </div>
<% } %>

<!-- ============================================== -->
<!-- TORNEI DISPONIBILI NEL LOCALE -->
<!-- ============================================== -->
<div class="card mb-3" style="border-top: 4px solid var(--accent-primary);">
    <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 1rem;"><i class="bi bi-trophy text-warning"></i> Tornei del Locale</h2>

    <% if (typeof tornei !== 'undefined' && tornei.length > 0) { %>
        <div class="grid-3" style="gap: 1rem;">
            <% tornei.forEach(function(t) { %>
                <div class="card" style="background: var(--bg-secondary);">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
                        <h3 style="font-size: 1rem; font-weight: 700; margin: 0;"><%= t.nome %></h3>
                        <span class="badge <%= t.stato === 'ATTIVO' ? 'badge-success' : t.stato === 'NON_ATTIVO' ? 'badge-info' : 'badge-guest' %>" style="font-size: 0.7rem;"><%= t.stato %></span>
                    </div>
                    <p class="text-muted text-sm mb-2"><i class="bi bi-controller"></i> <%= t.tipoGioco %></p>
                    <p class="text-muted text-sm mb-2" style="font-size: 0.75rem;">
                        <i class="bi bi-calendar-event"></i>
                        <%= new Date(t.dataInizio).toLocaleString('it-IT', { dateStyle: 'short', timeStyle: 'short' }) %> →
                        <%= new Date(t.dataFine).toLocaleString('it-IT', { dateStyle: 'short', timeStyle: 'short' }) %>
                    </p>

                    <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.75rem;">
                        <!-- Stato iscrizione (solo per giocatori autenticati non admin) -->
                        <% if (!isAdmin && !user.isGuest) { %>
                            <% if (t.isIscritto) { %>
                                <span class="badge badge-success" style="text-align: center; padding: 6px;"><i class="bi bi-check-circle"></i> Sei già iscritto</span>
                            <% } else if (t.stato === 'ATTIVO') { %>
                                <button class="btn btn-sm btn-primary" onclick="iscrivitiTorneo('<%= t.id %>')">
                                    <i class="bi bi-plus-circle"></i> Iscriviti
                                </button>
                            <% } %>

                            <!-- Disiscrizione (giocatore iscritto, torneo non ancora iniziato) -->
                            <% if (t.canUnenroll) { %>
                                <button class="btn btn-sm btn-outline-warning" onclick="disiscriviTorneo('<%= t.id %>')">
                                    <i class="bi bi-x-circle"></i> Disiscriviti
                                </button>
                            <% } %>
                        <% } %>

                        <!-- Cancella torneo (solo admin, non ancora iniziato) -->
                        <% if (t.canCancel) { %>
                            <button class="btn btn-sm btn-danger" onclick="cancellaTorneo('<%= t.id %>', '<%= t.nome %>')">
                                <i class="bi bi-trash"></i> Cancella Torneo
                            </button>
                        <% } %>

                        <!-- Dettaglio/Classifica (accessibile a tutti) -->
                        <button class="btn btn-sm" style="background: var(--bg-primary); color: var(--text-secondary); border: 1px solid var(--border-color);" onclick="mostraDettaglio('<%= t.id %>', '<%= t.nome %>')">
                            <i class="bi bi-bar-chart-line"></i> Dettaglio &amp; Classifica
                        </button>
                    </div>
                </div>
            <% }); %>
        </div>
        <div id="torneo-alert" class="alert d-none mt-3" style="font-size: 0.9rem;"></div>
    <% } else { %>
        <p class="text-muted">Nessun torneo disponibile per questo locale.</p>
    <% } %>
</div>

<% if (isAdmin) { %>
    <% if (stats.perGioco && stats.perGioco.length > 0) { %>
    <div class="card mb-3" style="border-top: 4px solid var(--accent-secondary);">
        <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 1.25rem;"><i class="bi bi-controller"></i> Statistiche per Gioco</h2>
        <div class="grid-3" style="gap: 1rem;">
            <% stats.perGioco.forEach(function(g) { %>
                <div class="card" style="background: var(--bg-secondary);">
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 0.75rem;">
                        <% if (g.gioco_id === 'calciobalilla') { %>
                            <i class="bi bi-dribbble" style="font-size: 1.5rem; color: var(--accent-primary);"></i>
                        <% } else if (g.gioco_id === 'biliardo') { %>
                            <i class="bi bi-8-circle" style="font-size: 1.5rem; color: #10b981;"></i>
                        <% } else { %>
                            <i class="bi bi-bullseye" style="font-size: 1.5rem; color: var(--danger);"></i>
                        <% } %>
                        <span style="font-weight: 700; font-size: 1.1rem; text-transform: capitalize;"><%= g.gioco_id %></span>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
                        <div>
                            <div class="text-muted text-sm">Partite</div>
                            <div style="font-weight: 700; font-size: 1.25rem;"><%= g.count %></div>
                        </div>
                        <div>
                            <div class="text-muted text-sm">
                                <% if (g.gioco_id === 'calciobalilla') { %>
                                    Media Gol
                                <% } else if (g.gioco_id === 'freccette') { %>
                                    Punti Medi Sottratti
                                <% } else if (g.gioco_id === 'biliardo') { %>
                                    Palle Imbucate Medie
                                <% } else { %>
                                    Punteggio Medio
                                <% } %>
                            </div>
                            <div style="font-weight: 700; font-size: 1.25rem;">
                                <%= Math.round(g.avg_p1 * 10) / 10 %> — <%= Math.round(g.avg_p2 * 10) / 10 %>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
    <% } %>

    <!-- Ultime Partite (tabella con stato sync) -->
    <% if (stats.ultimePartite && stats.ultimePartite.length > 0) { %>
    <div class="card mb-3">
        <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 1.25rem;"><i class="bi bi-journal-text"></i> Ultime Partite</h2>
        <div style="overflow-x: auto;">
            <table style="width: 100%; text-align: left; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--border-color); color: var(--text-secondary);">
                        <th style="padding: 10px;">Gioco</th>
                        <th style="padding: 10px;">Giocatore 1</th>
                        <th style="padding: 10px;">Giocatore 2</th>
                        <th style="padding: 10px;">Punteggio</th>
                        <th style="padding: 10px;">Data</th>
                        <th style="padding: 10px;">Sync</th>
                    </tr>
                </thead>
                <tbody>
                    <% stats.ultimePartite.forEach(function(p) { %>
                        <tr style="border-bottom: 1px solid var(--border-color);">
                            <td style="padding: 10px; font-weight: 600;">
                                <% if (p.gioco_id === 'calciobalilla') { %>
                                    <i class="bi bi-dribbble"></i>
                                <% } else if (p.gioco_id === 'biliardo') { %>
                                    <i class="bi bi-8-circle"></i>
                                <% } else { %>
                                    <i class="bi bi-bullseye"></i>
                                <% } %>
                                <%= p.gioco_id %>
                            </td>
                            <td style="padding: 10px; font-weight: 600;"><%= p.giocatore_1_username || (p.giocatore_1_id ? p.giocatore_1_id.substring(0, 8) + '...' : 'Ospite') %></td>
                            <td style="padding: 10px; font-weight: 600;"><%= p.giocatore_2_username || (p.giocatore_2_id ? p.giocatore_2_id.substring(0, 8) + '...' : 'Ospite') %></td>
                            <td style="padding: 10px; font-weight: 700;"><%= p.punteggio_1 %> — <%= p.punteggio_2 %></td>
                            <td style="padding: 10px;" class="text-muted text-sm"><%= new Date(p.data_fine).toLocaleString('it-IT', { timeZone: 'Europe/Rome' }) %></td>
                            <td style="padding: 10px;">
                                <% if (p.sincronizzata) { %>
                                    <span class="badge badge-success"><i class="bi bi-check-lg"></i></span>
                                <% } else { %>
                                    <span class="badge badge-warning"><i class="bi bi-hourglass-split"></i></span>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
    <% } else if (stats.totalePartite === 0) { %>
    <div class="card mb-3" style="text-align: center; padding: 3rem;">
        <i class="bi bi-inbox" style="font-size: 3rem; color: var(--text-muted); margin-bottom: 1rem; display: block;"></i>
        <p class="text-muted">Nessuna partita ancora giocata su questo locale.</p>
    </div>
    <% } %>

<% } %>

<!-- ============================================== -->
<!-- MODALE DETTAGLIO TORNEO -->
<!-- ============================================== -->
<div id="modal-dettaglio" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.7); z-index:1000; align-items:center; justify-content:center;">
    <div style="background: var(--bg-card); border-radius: var(--radius-lg); padding: 2rem; max-width: 700px; width: 90%; max-height: 80vh; overflow-y: auto; position:relative;">
        <button onclick="chiudiModal()" style="position:absolute; top:1rem; right:1rem; background:none; border:none; color:var(--text-muted); font-size:1.5rem; cursor:pointer;"><i class="bi bi-x-lg"></i></button>
        <h2 id="modal-titolo" style="font-size:1.4rem; font-weight:800; margin-bottom:1.5rem;"><i class="bi bi-trophy text-warning"></i> Dettaglio Torneo</h2>

        <!-- Tabs -->
        <div style="display:flex; gap:0; margin-bottom:1rem; border-bottom:1px solid var(--border-color);">
            <button id="tab-classifica" onclick="switchTab('classifica')" style="padding:8px 16px; border:none; background:none; font-weight:700; color:var(--accent-primary); border-bottom:2px solid var(--accent-primary); cursor:pointer; font-family:'Inter',sans-serif;">Classifica</button>
            <button id="tab-iscritti" onclick="switchTab('iscritti')" style="padding:8px 16px; border:none; background:none; font-weight:700; color:var(--text-muted); cursor:pointer; font-family:'Inter',sans-serif;">Giocatori Iscritti</button>
        </div>

        <!-- Pannello Classifica -->
        <div id="panel-classifica">
            <div id="classifica-body"><p class="text-muted">Caricamento...</p></div>
        </div>
        <!-- Pannello Iscritti -->
        <div id="panel-iscritti" style="display:none;">
            <div id="iscritti-body"><p class="text-muted">Caricamento...</p></div>
        </div>
    </div>
</div>

<script>
    // ---- Sync ----
    async function triggerSync() {
        const btn = document.getElementById('btn-sync');
        const status = document.getElementById('sync-status');
        btn.disabled = true;
        btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Sincronizzazione...';
        status.textContent = '';
        try {
            const res = await fetch('/sync/now', { method: 'POST' });
            const data = await res.json();
            if (res.ok) {
                status.innerHTML = '<i class="bi bi-check-circle"></i> ' + (data.salvate || 0) + ' partite sincronizzate';
                status.style.color = 'var(--success)';
                setTimeout(() => window.location.reload(), 2000);
            } else {
                status.innerHTML = '<i class="bi bi-exclamation-triangle"></i> ' + (data.error || 'Errore');
                status.style.color = 'var(--warning)';
            }
        } catch (err) {
            status.innerHTML = '<i class="bi bi-x-circle"></i> Errore: servizio cloud non disponibile al momento';
            status.style.color = 'var(--danger)';
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-arrow-repeat"></i> Sincronizza Ora';
        }
    }

    // ---- Helper alert ----
    function showTorneoAlert(msg, type) {
        const alertBox = document.getElementById('torneo-alert');
        if (!alertBox) return;
        alertBox.className = 'alert alert-' + type + ' mt-3';
        alertBox.innerHTML = msg;
        alertBox.classList.remove('d-none');
        setTimeout(() => window.location.reload(), 2500);
    }

    // ---- Iscrizione ----
    async function iscrivitiTorneo(torneoId) {
        try {
            const res = await fetch('/dashboard/tornei/iscriviti', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ torneoId, localeId: '<%= localeId %>' })
            });
            const data = await res.json();
            if (res.ok) {
                showTorneoAlert('<i class="bi bi-check-circle"></i> Iscrizione completata per il locale <%= localeId %>!', 'success');
            } else {
                showTorneoAlert('<i class="bi bi-exclamation-triangle"></i> ' + (data.error || 'Errore'), 'warning');
            }
        } catch (err) {
            showTorneoAlert('<i class="bi bi-x-circle"></i> Errore di rete: ' + err.message, 'danger');
        }
    }

    // ---- Disiscrizione ----
    async function disiscriviTorneo(torneoId) {
        if (!confirm('Sei sicuro di volerti disiscrivere da questo torneo?')) return;
        try {
            const res = await fetch('/dashboard/tornei/disiscrivi', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ torneoId })
            });
            const data = await res.json();
            if (res.ok) {
                showTorneoAlert('<i class="bi bi-check-circle"></i> Disiscrizione completata!', 'success');
            } else {
                showTorneoAlert('<i class="bi bi-exclamation-triangle"></i> ' + (data.error || 'Errore'), 'warning');
            }
        } catch (err) {
            showTorneoAlert('<i class="bi bi-x-circle"></i> Errore di rete: ' + err.message, 'danger');
        }
    }

    // ---- Cancella Torneo ----
    async function cancellaTorneo(torneoId, nome) {
        if (!confirm('Sei sicuro di voler CANCELLARE il torneo "' + nome + '"? L\'operazione è irreversibile.')) return;
        try {
            const res = await fetch('/dashboard/tornei/cancella', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ torneoId })
            });
            const data = await res.json();
            if (res.ok) {
                showTorneoAlert('<i class="bi bi-check-circle"></i> Torneo cancellato!', 'success');
            } else {
                showTorneoAlert('<i class="bi bi-exclamation-triangle"></i> ' + (data.error || 'Errore'), 'warning');
            }
        } catch (err) {
            showTorneoAlert('<i class="bi bi-x-circle"></i> Errore di rete: ' + err.message, 'danger');
        }
    }

    // ---- Crea Torneo ----
    async function creaTorneo(e) {
        e.preventDefault();
        const alertBox = document.getElementById('crea-torneo-alert');
        alertBox.className = 'alert mt-2';
        alertBox.innerHTML = '<i class="bi bi-hourglass"></i> Creazione in corso...';
        alertBox.classList.remove('d-none');

        const nome = document.getElementById('t-nome').value;
        const giocoId = document.getElementById('t-gioco').value;
        const dataInizio = document.getElementById('t-inizio').value;
        const dataFine = document.getElementById('t-fine').value;

        try {
            const res = await fetch('/dashboard/tornei/crea', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ nome, giocoId, dataInizio, dataFine })
            });
            const data = await res.json();
            if (res.ok) {
                alertBox.className = 'alert alert-success mt-2';
                alertBox.innerHTML = '<i class="bi bi-check-circle"></i> Torneo creato con successo!';
                document.getElementById('form-crea-torneo').reset();
                setTimeout(() => window.location.reload(), 2000);
            } else {
                alertBox.className = 'alert alert-warning mt-2';
                alertBox.innerHTML = '<i class="bi bi-exclamation-triangle"></i> ' + (data.error || 'Errore');
            }
        } catch (err) {
            alertBox.className = 'alert alert-danger mt-2';
            alertBox.innerHTML = '<i class="bi bi-x-circle"></i> Errore di rete: ' + err.message;
        }
    }

    // ---- Modale Dettaglio ----
    function chiudiModal() {
        document.getElementById('modal-dettaglio').style.display = 'none';
    }

    function switchTab(tab) {
        document.getElementById('panel-classifica').style.display = tab === 'classifica' ? '' : 'none';
        document.getElementById('panel-iscritti').style.display = tab === 'iscritti' ? '' : 'none';
        document.getElementById('tab-classifica').style.color = tab === 'classifica' ? 'var(--accent-primary)' : 'var(--text-muted)';
        document.getElementById('tab-classifica').style.borderBottom = tab === 'classifica' ? '2px solid var(--accent-primary)' : 'none';
        document.getElementById('tab-iscritti').style.color = tab === 'iscritti' ? 'var(--accent-primary)' : 'var(--text-muted)';
        document.getElementById('tab-iscritti').style.borderBottom = tab === 'iscritti' ? '2px solid var(--accent-primary)' : 'none';
    }

    async function mostraDettaglio(torneoId, nome) {
        document.getElementById('modal-titolo').innerHTML = '<i class="bi bi-trophy text-warning"></i> ' + nome;
        document.getElementById('classifica-body').innerHTML = '<p class="text-muted">Caricamento...</p>';
        document.getElementById('iscritti-body').innerHTML = '<p class="text-muted">Caricamento...</p>';
        document.getElementById('modal-dettaglio').style.display = 'flex';
        switchTab('classifica');

        try {
            const res = await fetch('/dashboard/tornei/' + torneoId + '/dettaglio');
            const data = await res.json();

            // Classifica Locali
            let html = '<h4 style="font-size:0.95rem; font-weight:700; color:var(--warning); margin-bottom:0.5rem;"><i class="bi bi-shop"></i> Classifica Locali (Vincitori)</h4>';
            if (data.classificaLocali && data.classificaLocali.length > 0) {
                html += '<table style="width:100%; border-collapse:collapse; margin-bottom:1.5rem;">';
                html += '<thead><tr style="border-bottom:2px solid var(--border-color); color:var(--text-secondary); font-size:0.8rem;">';
                html += '<th style="padding:8px;">Pos.</th><th style="padding:8px;">Locale</th><th style="padding:8px; text-align:center;">Giocate</th><th style="padding:8px; text-align:center;">Vinte</th><th style="padding:8px; text-align:center;">% Vittorie</th></tr></thead><tbody>';
                data.classificaLocali.forEach(v => {
                    html += '<tr style="border-bottom:1px solid var(--border-color);">';
                    html += '<td style="padding:8px; font-weight:800; color:var(--accent-primary);">#' + v.posizione + '</td>';
                    html += '<td style="padding:8px; font-weight:600;"><i class="bi bi-shop text-warning"></i> ' + (v.localeNome || v.localeId) + '</td>';
                    html += '<td style="padding:8px; text-align:center;">' + v.partiteGiocate + '</td>';
                    html += '<td style="padding:8px; text-align:center; color:var(--success); font-weight:700;">' + v.partiteVinte + '</td>';
                    html += '<td style="padding:8px; text-align:center; font-weight:700;">' + v.percentualeVittorie + '%</td>';
                    html += '</tr>';
                });
                html += '</tbody></table>';
            } else {
                html += '<p class="text-muted mb-3">Nessun dato locali in classifica.</p>';
            }

            // Classifica Giocatori
            html += '<h4 style="font-size:0.95rem; font-weight:700; color:var(--accent-primary); margin-bottom:0.5rem;"><i class="bi bi-person-fill"></i> Classifica Giocatori</h4>';
            if (data.classificaGiocatori && data.classificaGiocatori.length > 0) {
                html += '<table style="width:100%; border-collapse:collapse;">';
                html += '<thead><tr style="border-bottom:2px solid var(--border-color); color:var(--text-secondary); font-size:0.8rem;">';
                html += '<th style="padding:8px;">Pos.</th><th style="padding:8px;">Giocatore</th><th style="padding:8px;">Locale Iscrizione</th><th style="padding:8px; text-align:center;">Giocate</th><th style="padding:8px; text-align:center;">% Vittorie</th></tr></thead><tbody>';
                data.classificaGiocatori.forEach(v => {
                    html += '<tr style="border-bottom:1px solid var(--border-color);">';
                    html += '<td style="padding:8px; font-weight:800; color:var(--accent-primary);">#' + v.posizione + '</td>';
                    html += '<td style="padding:8px; font-weight:600;">' + v.username + '</td>';
                    html += '<td style="padding:8px;"><span class="badge badge-info">' + (v.localeNome || v.localeId || 'N/A') + '</span></td>';
                    html += '<td style="padding:8px; text-align:center;">' + v.partiteGiocate + '</td>';
                    html += '<td style="padding:8px; text-align:center; font-weight:700;">' + v.percentualeVittorie + '%</td>';
                    html += '</tr>';
                });
                html += '</tbody></table>';
            } else {
                html += '<p class="text-muted">Nessun giocatore iscritto o in classifica.</p>';
            }
            document.getElementById('classifica-body').innerHTML = html;

            // Iscritti List
            if (data.iscritti && data.iscritti.length > 0) {
                let htmlIscr = '<ul style="list-style:none; padding:0; margin:0;">';
                data.iscritti.forEach(i => {
                    htmlIscr += '<li style="padding:8px 0; border-bottom:1px solid var(--border-color); display:flex; justify-content:space-between; align-items:center;">';
                    htmlIscr += '<div><i class="bi bi-person-circle" style="color:var(--accent-primary);"></i> <span style="font-weight:600;">' + i.utenteUsername + '</span></div>';
                    htmlIscr += '<div><span class="badge badge-info me-2">' + (i.localeNome || i.localeId || 'N/A') + '</span><span class="text-muted text-sm">' + new Date(i.dataIscrizione).toLocaleDateString("it-IT") + '</span></div>';
                    htmlIscr += '</li>';
                });
                htmlIscr += '</ul>';
                document.getElementById('iscritti-body').innerHTML = htmlIscr;
            } else {
                document.getElementById('iscritti-body').innerHTML = '<p class="text-muted">Nessun giocatore iscritto.</p>';
            }
        } catch (err) {
            document.getElementById('classifica-body').innerHTML = '<p class="text-muted">Errore caricamento: ' + err.message + '</p>';
        }
    }

    // Chiudi modale cliccando fuori
    document.getElementById('modal-dettaglio').addEventListener('click', function(e) {
        if (e.target === this) chiudiModal();
    });

    // ---- GRAFICI E FILTRI STATISTICHE GIOCATORE ----
    let currentUserPeriod = null;
    let userTrendChartInstance = null;
    let userGamesChartInstance = null;

    const rawPlayerStats = <%- JSON.stringify(typeof playerStats !== 'undefined' ? playerStats : null) %>;
    const currentUserId = <%- JSON.stringify(typeof user !== 'undefined' && user ? user.id : null) %>;

    function filterUserStats(giorni, btnElement) {
        currentUserPeriod = giorni;
        if (btnElement) {
            document.querySelectorAll('.user-period-btn').forEach(b => {
                b.classList.remove('btn-primary', 'active');
                b.classList.add('btn-secondary');
            });
            btnElement.classList.remove('btn-secondary');
            btnElement.classList.add('btn-primary', 'active');
        }

        const selectElem = document.getElementById('user-gioco-select');
        const giocoFilter = selectElem ? selectElem.value : '';

        if (!rawPlayerStats || !rawPlayerStats.ultimePartite) return;

        const now = new Date();
        const filteredMatches = rawPlayerStats.ultimePartite.filter(p => {
            // Filter by date
            if (giorni) {
                const matchDate = new Date(p.data_fine);
                const diffTime = Math.abs(now - matchDate);
                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                if (diffDays > giorni) return false;
            }
            // Filter by game
            if (giocoFilter && p.gioco_id) {
                const g = p.gioco_id.toLowerCase();
                const f = giocoFilter.toLowerCase();
                if (g !== f && !g.includes(f) && !f.includes(g)) return false;
            }
            return true;
        });

        // Recalculate KPIs
        let total = filteredMatches.length;
        let wins = 0;
        let losses = 0;
        filteredMatches.forEach(p => {
            const isP1 = p.giocatore_1_id === currentUserId;
            const won = isP1 ? (p.punteggio_1 > p.punteggio_2) : (p.punteggio_2 > p.punteggio_1);
            if (won) wins++; else losses++;
        });

        let winRate = total > 0 ? Math.round((wins / total) * 1000) / 10 : 0;

        // Update KPI Elements
        const pEl = document.getElementById('u-stat-partite');
        const vEl = document.getElementById('u-stat-vittorie');
        const sEl = document.getElementById('u-stat-sconfitte');
        const wEl = document.getElementById('u-stat-winrate');

        if (pEl) pEl.innerText = total;
        if (vEl) vEl.innerText = wins;
        if (sEl) sEl.innerText = losses;
        if (wEl) {
            wEl.innerText = winRate + '%';
            wEl.style.color = winRate >= 50 ? 'var(--success)' : 'var(--danger)';
        }

        // Redraw Charts
        renderUserCharts(filteredMatches);

        // Update Ultime Partite List DOM
        const listContainer = document.getElementById('user-matches-list');
        if (listContainer) {
            if (filteredMatches.length === 0) {
                listContainer.innerHTML = '<p class="text-muted" style="padding: 1rem 0;">Nessuna partita trovata con i filtri selezionati.</p>';
            } else {
                let html = '';
                filteredMatches.forEach(p => {
                    const isP1 = p.giocatore_1_id === currentUserId;
                    const won = isP1 ? (p.punteggio_1 > p.punteggio_2) : (p.punteggio_2 > p.punteggio_1);
                    const icon = (p.gioco_id === 'calciobalilla') ? '<i class="bi bi-dribbble"></i>' : (p.gioco_id === 'biliardo' ? '<i class="bi bi-8-circle"></i>' : '<i class="bi bi-bullseye"></i>');
                    const dateStr = new Date(p.data_fine).toLocaleString('it-IT', { timeZone: 'Europe/Rome' });

                    html += `<div class="user-match-item" style="display: flex; align-items: center; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--border-color);">
                        <div><span class="badge ${won ? 'badge-success' : 'badge-danger'}">${won ? 'VITTORIA' : 'SCONFITTA'}</span></div>
                        <div style="font-weight: 600; text-transform: capitalize;">${icon} ${p.gioco_id || 'partita'}</div>
                        <div style="font-weight: 700;">${p.punteggio_1} — ${p.punteggio_2}</div>
                        <div class="text-muted text-sm">${dateStr}</div>
                    </div>`;
                });
                listContainer.innerHTML = html;
            }
        }
    }

    function renderUserCharts(matches) {
        const sorted = [...matches].sort((a, b) => new Date(a.data_fine) - new Date(b.data_fine));
        const labels = sorted.map(m => new Date(m.data_fine).toLocaleDateString('it-IT', { month: 'short', day: 'numeric' }));
        const userScores = sorted.map(m => m.giocatore_1_id === currentUserId ? m.punteggio_1 : m.punteggio_2);

        const ctxTrend = document.getElementById('userTrendChart');
        if (ctxTrend) {
            if (userTrendChartInstance) userTrendChartInstance.destroy();
            userTrendChartInstance = new Chart(ctxTrend, {
                type: 'line',
                data: {
                    labels: labels.length > 0 ? labels : ['Nessun dato'],
                    datasets: [{
                        label: 'Punti Realizzati',
                        data: userScores.length > 0 ? userScores : [0],
                        borderColor: '#06b6d4',
                        backgroundColor: 'rgba(6, 182, 212, 0.15)',
                        fill: true,
                        tension: 0.35,
                        borderWidth: 2,
                        pointRadius: 4,
                        pointBackgroundColor: '#06b6d4'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: { ticks: { color: '#94a3b8', font: { size: 10 } }, grid: { display: false } },
                        y: { ticks: { color: '#94a3b8', precision: 0 }, grid: { color: 'rgba(255,255,255,0.05)' }, beginAtZero: true }
                    },
                    plugins: { legend: { display: false } }
                }
            });
        }

        const gameWins = {};
        sorted.forEach(m => {
            const isP1 = m.giocatore_1_id === currentUserId;
            const won = isP1 ? (m.punteggio_1 > m.punteggio_2) : (m.punteggio_2 > m.punteggio_1);
            if (won) {
                const g = m.gioco_id || 'altro';
                gameWins[g] = (gameWins[g] || 0) + 1;
            }
        });

        const ctxGames = document.getElementById('userGamesChart');
        if (ctxGames) {
            if (userGamesChartInstance) userGamesChartInstance.destroy();
            const gLabels = Object.keys(gameWins);
            const gValues = Object.values(gameWins);

            userGamesChartInstance = new Chart(ctxGames, {
                type: 'doughnut',
                data: {
                    labels: gLabels.length > 0 ? gLabels : ['Nessuna vittoria'],
                    datasets: [{
                        data: gValues.length > 0 ? gValues : [1],
                        backgroundColor: ['#3b82f6', '#f59e0b', '#10b981', '#ef4444'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { color: '#94a3b8', font: { family: 'Inter', size: 11 } } }
                    }
                }
            });
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        if (rawPlayerStats) {
            filterUserStats(null, null);
        }
    });
</script>

<%- include('partials/footer') %>
