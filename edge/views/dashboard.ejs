<%- include('partials/header') %>

<!-- Page Header -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <div>
        <h1 style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.03em;">
            <i class="bi bi-speedometer2"></i> Dashboard
        </h1>
        <p class="text-muted" style="font-size: 0.9rem;">
            Pannello di controllo — <%= localeId %>
        </p>
    </div>
    <a href="/" class="btn btn-secondary"><i class="bi bi-house"></i> Home</a>
</div>

<!-- Status Cards -->
<div class="grid-3 mb-3">
    <!-- User Info -->
    <div class="card">
        <div class="card-subtitle">UTENTE</div>
        <div class="card-title" style="font-size: 1.25rem;">
            <% if (user.isGuest) { %>
                <i class="bi bi-person"></i>
            <% } else { %>
                <i class="bi bi-shield-check"></i>
            <% } %>
            <%= user.username %>
        </div>
        <div class="mt-1">
            <% if (user.isGuest) { %>
                <span class="badge badge-guest">Ospite</span>
            <% } else { %>
                <span class="badge badge-success">Autenticato</span>
            <% } %>
            <% if (user.roles && user.roles.length > 0) { %>
                <% user.roles.forEach(function(role) { %>
                    <span class="badge badge-info"><%= role %></span>
                <% }); %>
            <% } %>
        </div>
        <% if (user.email) { %>
            <p class="text-muted text-sm mt-1"><%= user.email %></p>
        <% } %>
    </div>

    <% if (isAdmin) { %>
    <!-- MQTT Status -->
    <div class="card">
        <div class="card-subtitle">BROKER MQTT</div>
        <div class="card-title" style="font-size: 1.25rem;">
            <% if (mqttStatus.status === 'connected') { %>
                <span class="dot dot-success"></span> Connesso
            <% } else if (mqttStatus.status === 'reconnecting') { %>
                <i class="bi bi-arrow-repeat" style="color: var(--warning);"></i> Riconnessione...
            <% } else { %>
                <span class="dot dot-danger"></span> Disconnesso
            <% } %>
        </div>
        <p class="text-muted text-sm mt-1">
            Topic: <code><%= mqttStatus.topic %></code>
        </p>
    </div>

    <!-- Locale Info -->
    <div class="card">
        <div class="card-subtitle">LOCALE</div>
        <div class="card-title" style="font-size: 1.25rem;">
            <i class="bi bi-geo-alt"></i> <%= localeId %>
        </div>
        <p class="text-muted text-sm mt-1">
            <strong><%= stats.totalePartite %></strong> partite giocate ·
            <strong><%= stats.inAttesaDiSync %></strong> in coda sync
        </p>
    </div>
    <% } %>
</div>

<% if (!isAdmin && !user.isGuest && playerStats) { %>
    <!-- ============================================== -->
    <!-- STATISTICHE GIOCATORE -->
    <!-- ============================================== -->
    <div class="card mb-3" style="border-top: 4px solid var(--accent-secondary); background: linear-gradient(180deg, rgba(6, 182, 212, 0.05) 0%, transparent 100%);">
        <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 1rem;"><i class="bi bi-bar-chart-line"></i> Le tue Statistiche</h2>

        <div class="grid-3" style="gap: 1rem; margin-bottom: 1.25rem;">
            <div class="card" style="background: var(--bg-secondary); text-align: center;">
                <div class="card-subtitle">PARTITE GIOCATE</div>
                <div style="font-size: 2.5rem; font-weight: 800; color: var(--accent-primary);"><%= playerStats.totalePartite %></div>
            </div>
            <div class="card" style="background: var(--bg-secondary); text-align: center;">
                <div class="card-subtitle">VITTORIE / SCONFITTE</div>
                <div style="font-size: 2rem; font-weight: 800;">
                    <span style="color: var(--success);"><%= playerStats.vittorie %></span>
                    <span style="color: var(--text-muted);"> / </span>
                    <span style="color: var(--danger);"><%= playerStats.sconfitte %></span>
                </div>
            </div>
            <div class="card" style="background: var(--bg-secondary); text-align: center;">
                <div class="card-subtitle">% VITTORIE</div>
                <div style="font-size: 2.5rem; font-weight: 800; color: <%= playerStats.percentualeVittorie >= 50 ? 'var(--success)' : 'var(--danger)' %>;">
                    <%= playerStats.percentualeVittorie %>%
                </div>
            </div>
        </div>

        <% if (playerStats.ultimePartite && playerStats.ultimePartite.length > 0) { %>
            <h3 style="font-size: 1rem; color: var(--text-secondary); margin-bottom: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">Ultime Partite</h3>
            <% playerStats.ultimePartite.forEach(function(p) {
                var isP1 = p.giocatore_1_id === user.id;
                var won = isP1 ? (p.punteggio_1 > p.punteggio_2) : (p.punteggio_2 > p.punteggio_1);
            %>
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--border-color);">
                    <div>
                        <span class="badge <%= won ? 'badge-success' : 'badge-danger' %>"><%= won ? 'VITTORIA' : 'SCONFITTA' %></span>
                    </div>
                    <div style="font-weight: 600;">
                        <% if (p.gioco_id === 'calciobalilla') { %>
                            <i class="bi bi-dribbble"></i>
                        <% } else { %>
                            <i class="bi bi-bullseye"></i>
                        <% } %>
                        <%= p.gioco_id %>
                    </div>
                    <div style="font-weight: 700;">
                        <%= p.punteggio_1 %> — <%= p.punteggio_2 %>
                    </div>
                    <div class="text-muted text-sm">
                        <%= new Date(p.data_fine).toLocaleDateString('it-IT') %>
                    </div>
                </div>
            <% }); %>
        <% } %>
    </div>
<% } %>

<% if (isAdmin) { %>
    <!-- ============================================== -->
    <!-- PANNELLO AMMINISTRATORE -->
    <!-- ============================================== -->
    <div class="card mb-3" style="border-top: 4px solid var(--warning); background: linear-gradient(180deg, rgba(245, 158, 11, 0.05) 0%, transparent 100%);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h2 style="font-size: 1.4rem; font-weight: 700; color: var(--warning);">
                <% if (user.roles && user.roles.includes('admin_piattaforma')) { %>
                    <i class="bi bi-globe"></i> Console Admin Piattaforma
                <% } else { %>
                    <i class="bi bi-gear"></i> Console Admin Locale
                <% } %>
            </h2>
            <% if (user.roles && user.roles.includes('admin_piattaforma')) { %>
                <span class="badge badge-danger">SUPER ADMIN</span>
            <% } %>
        </div>

        <!-- Quick Stats -->
        <div class="grid-3" style="gap: 1rem; margin-bottom: 1.5rem;">
            <div class="card" style="background: var(--bg-secondary); text-align: center;">
                <div class="card-subtitle">PARTITE TOTALI</div>
                <div style="font-size: 2.5rem; font-weight: 800; color: var(--accent-primary);"><%= stats.totalePartite %></div>
            </div>
            <div class="card" style="background: var(--bg-secondary); text-align: center;">
                <div class="card-subtitle">IN CODA SYNC</div>
                <div style="font-size: 2.5rem; font-weight: 800; color: <%= stats.inAttesaDiSync > 0 ? 'var(--warning)' : 'var(--success)' %>;">
                    <%= stats.inAttesaDiSync %>
                </div>
            </div>
            <div class="card" style="background: var(--bg-secondary); text-align: center;">
                <div class="card-subtitle">SINCRONIZZATE</div>
                <div style="font-size: 2.5rem; font-weight: 800; color: var(--success);"><%= stats.sincronizzate %></div>
            </div>
        </div>

        <!-- Sync Action -->
        <div style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: center;">
            <button class="btn btn-warning" onclick="triggerSync()" id="btn-sync">
                <i class="bi bi-arrow-repeat"></i> Sincronizza Ora
            </button>
            <span class="text-muted text-sm" style="align-self: center;" id="sync-status"></span>
        </div>
    </div>

    <!-- Statistiche per Gioco -->
    <% if (stats.perGioco && stats.perGioco.length > 0) { %>
    <div class="card mb-3" style="border-top: 4px solid var(--accent-secondary);">
        <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 1.25rem;"><i class="bi bi-controller"></i> Statistiche per Gioco</h2>
        <div class="grid-3" style="gap: 1rem;">
            <% stats.perGioco.forEach(function(g) { %>
                <div class="card" style="background: var(--bg-secondary);">
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 0.75rem;">
                        <% if (g.gioco_id === 'calciobalilla') { %>
                            <i class="bi bi-dribbble" style="font-size: 1.5rem; color: var(--accent-primary);"></i>
                        <% } else { %>
                            <i class="bi bi-bullseye" style="font-size: 1.5rem; color: var(--danger);"></i>
                        <% } %>
                        <span style="font-weight: 700; font-size: 1.1rem; text-transform: capitalize;"><%= g.gioco_id %></span>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
                        <div>
                            <div class="text-muted text-sm">Partite</div>
                            <div style="font-weight: 700; font-size: 1.25rem;"><%= g.count %></div>
                        </div>
                        <div>
                            <div class="text-muted text-sm">Punteggio Medio</div>
                            <div style="font-weight: 700; font-size: 1.25rem;">
                                <%= Math.round(g.avg_p1 * 10) / 10 %> — <%= Math.round(g.avg_p2 * 10) / 10 %>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
    <% } %>

    <!-- Ultime Partite (tabella con stato sync) -->
    <% if (stats.ultimePartite && stats.ultimePartite.length > 0) { %>
    <div class="card mb-3">
        <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 1.25rem;"><i class="bi bi-journal-text"></i> Ultime Partite</h2>
        <div style="overflow-x: auto;">
            <table style="width: 100%; text-align: left; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--border-color); color: var(--text-secondary);">
                        <th style="padding: 10px;">Gioco</th>
                        <th style="padding: 10px;">Giocatore 1</th>
                        <th style="padding: 10px;">Giocatore 2</th>
                        <th style="padding: 10px;">Punteggio</th>
                        <th style="padding: 10px;">Data</th>
                        <th style="padding: 10px;">Sync</th>
                    </tr>
                </thead>
                <tbody>
                    <% stats.ultimePartite.forEach(function(p) { %>
                        <tr style="border-bottom: 1px solid var(--border-color);">
                            <td style="padding: 10px; font-weight: 600;">
                                <% if (p.gioco_id === 'calciobalilla') { %>
                                    <i class="bi bi-dribbble"></i>
                                <% } else { %>
                                    <i class="bi bi-bullseye"></i>
                                <% } %>
                                <%= p.gioco_id %>
                            </td>
                            <td style="padding: 10px;"><%= p.giocatore_1_id ? p.giocatore_1_id.substring(0, 8) + '...' : 'Ospite' %></td>
                            <td style="padding: 10px;"><%= p.giocatore_2_id ? p.giocatore_2_id.substring(0, 8) + '...' : 'Ospite' %></td>
                            <td style="padding: 10px; font-weight: 700;"><%= p.punteggio_1 %> — <%= p.punteggio_2 %></td>
                            <td style="padding: 10px;" class="text-muted text-sm"><%= new Date(p.data_fine).toLocaleString('it-IT') %></td>
                            <td style="padding: 10px;">
                                <% if (p.sincronizzata) { %>
                                    <span class="badge badge-success"><i class="bi bi-check-lg"></i></span>
                                <% } else { %>
                                    <span class="badge badge-warning"><i class="bi bi-hourglass-split"></i></span>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
    <% } else if (stats.totalePartite === 0) { %>
    <div class="card mb-3" style="text-align: center; padding: 3rem;">
        <i class="bi bi-inbox" style="font-size: 3rem; color: var(--text-muted); margin-bottom: 1rem; display: block;"></i>
        <p class="text-muted">Nessuna partita ancora giocata su questo locale.</p>
    </div>
    <% } %>

<% } %>

<script>
    async function triggerSync() {
        const btn = document.getElementById('btn-sync');
        const status = document.getElementById('sync-status');
        btn.disabled = true;
        btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Sincronizzazione...';
        status.textContent = '';

        try {
            const res = await fetch('/sync/now', { method: 'POST' });
            const data = await res.json();

            if (res.ok) {
                status.innerHTML = '<i class="bi bi-check-circle"></i> ' + (data.salvate || 0) + ' partite sincronizzate';
                status.style.color = 'var(--success)';
                setTimeout(function() { window.location.reload(); }, 2000);
            } else {
                status.innerHTML = '<i class="bi bi-exclamation-triangle"></i> ' + (data.error || 'Errore');
                status.style.color = 'var(--warning)';
            }
        } catch (err) {
            status.innerHTML = '<i class="bi bi-x-circle"></i> Errore di rete: ' + err.message;
            status.style.color = 'var(--danger)';
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-arrow-repeat"></i> Sincronizza Ora';
        }
    }
</script>

<%- include('partials/footer') %>
