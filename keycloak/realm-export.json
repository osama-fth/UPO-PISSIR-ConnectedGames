{
  "id": "pissir-realm",
  "realm": "pissir-realm",
  "displayName": "Connected Games Platform",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      {
        "name": "giocatore",
        "description": "Ruolo base per i giocatori della piattaforma"
      },
      {
        "name": "admin_locale",
        "description": "Amministratore di un locale fisico"
      },
      {
        "name": "admin_gioco",
        "description": "Amministratore delle tipologie di gioco"
      },
      {
        "name": "admin_piattaforma",
        "description": "Amministratore globale della piattaforma"
      }
    ]
  },
  "clients": [
    {
      "clientId": "edge-client",
      "name": "Edge Gateway Application",
      "description": "Client OIDC per gli Edge Node locali",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+",
        "_comment": "SOLO DEV \u2014 restringere redirectUris e webOrigins in produzione"
      }
    }
  ],
  "users": [
    {
      "username": "mario",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "giocatore"
      ]
    },
    {
      "username": "admin_test",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin_locale"
      ]
    }
  ]
}