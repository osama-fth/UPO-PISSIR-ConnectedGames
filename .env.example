# ============================================================
# .env.example — Connected Games Platform
# Copia in .env e compila prima di avviare con docker compose up
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD

# --- OIDC Client (Edge → Keycloak) ---
KEYCLOAK_CLIENT_ID=edge-app
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_KEYCLOAK_CLIENT_SECRET

# --- Sessione Edge ---
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# --- MQTT Locale 1 (BAR_BELVEDERE) ---
MQTT1_PUBLISH_USER=simulator
MQTT1_PUBLISH_PASSWORD=CHANGE_ME_MQTT1_PUB
MQTT1_SUBSCRIBE_USER=edge-client
MQTT1_SUBSCRIBE_PASSWORD=CHANGE_ME_MQTT1_SUB

# --- MQTT Locale 2 (SALA_GIOCHI_ROMA) ---
MQTT2_PUBLISH_USER=simulator
MQTT2_PUBLISH_PASSWORD=CHANGE_ME_MQTT2_PUB
MQTT2_SUBSCRIBE_USER=edge-client
MQTT2_SUBSCRIBE_PASSWORD=CHANGE_ME_MQTT2_SUB
