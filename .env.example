# ============================================================
# Configurazione Globale Connected Games Platform
# ============================================================

# --- PostgreSQL Admin & Segregated Users ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword
PLATFORM_DB_USER=platform_user
PLATFORM_DB_PASSWORD=platform_pass123
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASSWORD=keycloak_pass123

# --- Keycloak Admin Console ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- OIDC Client & Resource Servers ---
KEYCLOAK_CLIENT_ID=edge-client # (NON MODIFICARE - Coincide con il client OIDC in keycloak/realm-export.json)
JWT_ISSUER_URI=http://localhost:9080/realms/Connected-Games # (NON MODIFICARE - URI del realm Keycloak)
JWT_JWK_SET_URI=http://keycloak:8080/realms/Connected-Games/protocol/openid-connect/certs # (NON MODIFICARE - Endpoint interno JWKS)

# --- Sessione Edge ---
SESSION_SECRET=dev-session-secret-change-me

# --- Client Credentials Sincronizzazione Edge → Cloud ---
SYNC_CLIENT_ID=edge-sync-client # (NON MODIFICARE - Client ID sincronizzazione in Keycloak)
SYNC_CLIENT_SECRET=edge-sync-secret-12345 # (NON MODIFICARE - Secret sincronizzazione in Keycloak)

# --- MQTT Locale 1 (BAR_BELVEDERE) ---
MQTT1_PUBLISH_USER=BarBelvederePublisher # (NON MODIFICARE - Utente definito in mosquitto/locale1/acl.conf)
MQTT1_PUBLISH_PASSWORD=bar_belvedere_pub_pass123
MQTT1_SUBSCRIBE_USER=BarBelvedereSubscriber # (NON MODIFICARE - Utente definito in mosquitto/locale1/acl.conf)
MQTT1_SUBSCRIBE_PASSWORD=bar_belvedere_sub_pass123

# --- MQTT Locale 2 (SALA_GIOCHI_ROMA) ---
MQTT2_PUBLISH_USER=SalaGiochiRomaPublisher # (NON MODIFICARE - Utente definito in mosquitto/locale2/acl.conf)
MQTT2_PUBLISH_PASSWORD=sala_giochi_roma_pub_pass123
MQTT2_SUBSCRIBE_USER=SalaGiochiRomaSubscriber # (NON MODIFICARE - Utente definito in mosquitto/locale2/acl.conf)
MQTT2_SUBSCRIBE_PASSWORD=sala_giochi_roma_sub_pass123

# --- Porte Host ---
EDGE1_HOST_PORT=3001
EDGE2_HOST_PORT=3002


